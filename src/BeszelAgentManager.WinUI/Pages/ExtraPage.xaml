<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="BeszelAgentManager.WinUI.Pages.ExtraPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="10" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Padding="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4">
            <StackPanel Spacing="6">
                <TextBlock FontWeight="SemiBold" Text="GitHub Authentication" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Set a GitHub token to avoid API rate limiting. Token is stored encrypted (DPAPI)." />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Tip: If GITHUB_TOKEN is set as an environment variable, it overrides the saved token." />
                <Button x:Name="GitHubAuthButton" MinHeight="30" Padding="10,4" HorizontalAlignment="Left" Content="GitHub Auth..." Click="GitHubAuthButton_Click" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Padding="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4">
            <StackPanel Spacing="6">
                <TextBlock FontWeight="SemiBold" Text="Agent Fingerprint" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="View or reset the agent fingerprint (beszel-agent fingerprint view/reset)." />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Reset is useful if you cloned a VM or want to re-register this machine." />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button x:Name="ViewFingerprintButton" MinHeight="30" Padding="10,4" Content="View fingerprint" Click="ViewFingerprintButton_Click" />
                    <Button x:Name="ResetFingerprintButton" MinHeight="30" Padding="10,4" Content="Reset fingerprint" Click="ResetFingerprintButton_Click" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Padding="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4">
            <StackPanel Spacing="6">
                <TextBlock FontWeight="SemiBold" Text="Periodic service restart" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Optionally restart the Beszel Agent service on a fixed interval." />
                <CheckBox x:Name="AutoRestartCheckBox" Content="Enable periodic service restart" Click="AutoRestartCheckBox_Click" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock VerticalAlignment="Center" Text="Interval:" />
                    <TextBox
                        x:Name="RestartIntervalTextBox"
                        Width="64"
                        MaxLength="5"
                        Text="24"
                        LostFocus="RestartIntervalTextBox_LostFocus"
                        KeyDown="RestartIntervalTextBox_KeyDown" />
                    <ComboBox
                        x:Name="RestartIntervalUnitComboBox"
                        Width="104"
                        SelectionChanged="RestartIntervalUnitComboBox_SelectionChanged">
                        <ComboBoxItem Content="Hours" Tag="hours" />
                        <ComboBoxItem Content="Minutes" Tag="minutes" />
                    </ComboBox>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Padding="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4">
            <StackPanel Spacing="6">
                <TextBlock FontWeight="SemiBold" Text="Background service" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Repair, remove, or check the BeszelAgentManager privileged background service." TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="InstallBackgroundServiceButton" MinHeight="30" Padding="10,4" Content="Install" Click="InstallBackgroundServiceButton_Click" />
                    <Button x:Name="UninstallBackgroundServiceButton" MinHeight="30" Padding="10,4" Content="Uninstall" Click="UninstallBackgroundServiceButton_Click" />
                    <Button x:Name="CheckBackgroundServiceButton" MinHeight="30" Padding="10,4" Content="Check" Click="CheckBackgroundServiceButton_Click" />
                    <TextBlock x:Name="BackgroundServiceStatusText" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Status: checking..." />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="4" Padding="10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="4">
            <StackPanel Spacing="6">
                <TextBlock FontWeight="SemiBold" Text="Windows Defender exclusion" />
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Optionally exclude only the BeszelAgentManager installation folder. This is never enabled automatically." TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button x:Name="DefenderExclusionButton" MinHeight="30" Padding="10,4" Click="DefenderExclusionButton_Click" />
                    <Button MinHeight="30" Padding="10,4" Content="Third-party AV instructions…" Click="ThirdPartyAvButton_Click" />
                </StackPanel>
            </StackPanel>
        </Border>

    </Grid>
</Page>
