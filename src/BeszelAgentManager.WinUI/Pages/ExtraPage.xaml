<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="BeszelAgentManager.WinUI.Pages.ExtraPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:l="using:BeszelAgentManager.WinUI.Services"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="8" ColumnSpacing="8" RowSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Padding="10,8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6">
                <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" Text="{l:Localize Key=GitHubAuthentication2}" />
                    <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{l:Localize Key=StoreADPAPIEncryptedTokenToAvoidAPIRate}" TextWrapping="Wrap" />
                    <Button x:Name="GitHubAuthButton" MinHeight="28" Padding="10,3" HorizontalAlignment="Left" Content="{l:Localize Key=GitHubAuth}" Click="GitHubAuthButton_Click" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Padding="10,8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6">
                <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" Text="{l:Localize Key=AgentFingerprint2}" />
                    <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{l:Localize Key=ViewOrResetTheFingerprintAfterCloningAVM}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button x:Name="ViewFingerprintButton" MinHeight="28" Padding="10,3" Content="{l:Localize Key=View}" Click="ViewFingerprintButton_Click" />
                        <Button x:Name="ResetFingerprintButton" MinHeight="28" Padding="10,3" Content="{l:Localize Key=Reset}" Click="ResetFingerprintButton_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Padding="10,8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6">
                <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" Text="{l:Localize Key=PeriodicServiceRestart}" />
                    <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{l:Localize Key=RestartBeszelAgentAutomaticallyOnAFixedInterval}" TextWrapping="Wrap" />
                    <CheckBox x:Name="AutoRestartCheckBox" MinHeight="28" Content="{l:Localize Key=EnablePeriodicRestart}" Click="AutoRestartCheckBox_Click" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock VerticalAlignment="Center" Text="{l:Localize Key=Every}" />
                        <TextBox
                            x:Name="RestartIntervalTextBox"
                            Width="58"
                            MinHeight="28"
                            MaxLength="5"
                            Text="24"
                            LostFocus="RestartIntervalTextBox_LostFocus"
                            KeyDown="RestartIntervalTextBox_KeyDown" />
                        <ComboBox
                            x:Name="RestartIntervalUnitComboBox"
                            Width="100"
                            MinHeight="28"
                            SelectionChanged="RestartIntervalUnitComboBox_SelectionChanged">
                            <ComboBoxItem Content="{l:Localize Key=Hours2}" Tag="hours" />
                            <ComboBoxItem Content="{l:Localize Key=Minutes}" Tag="minutes" />
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="1" Grid.Column="1" Padding="10,8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6">
                <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" Text="{l:Localize Key=WebSocketOfflineBackoff}" />
                    <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{l:Localize Key=PauseAfter12FailuresRetryAfter125}" TextWrapping="Wrap" />
                    <CheckBox x:Name="WebSocketBackoffCheckBox" MinHeight="28" Content="{l:Localize Key=ReduceRetriesWhileHubIsUnreachable}" Click="WebSocketBackoffCheckBox_Click" />
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Padding="10,8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6">
                <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" Text="{l:Localize Key=BackgroundService}" />
                    <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{l:Localize Key=RepairRemoveOrVerifyPrivilegedBackgroundService}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button x:Name="InstallBackgroundServiceButton" MinHeight="28" Padding="10,3" Content="{l:Localize Key=Install}" Click="InstallBackgroundServiceButton_Click" />
                        <Button x:Name="UninstallBackgroundServiceButton" MinHeight="28" Padding="10,3" Content="{l:Localize Key=Uninstall}" Click="UninstallBackgroundServiceButton_Click" />
                        <Button x:Name="CheckBackgroundServiceButton" MinHeight="28" Padding="10,3" Content="{l:Localize Key=Check}" Click="CheckBackgroundServiceButton_Click" />
                        <TextBlock x:Name="BackgroundServiceStatusText" VerticalAlignment="Center" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{l:Localize Key=Checking}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Grid.Column="1" Padding="10,8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6">
                <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" Text="{l:Localize Key=AntivirusExclusions}" />
                    <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{l:Localize Key=ManageOptionalDefenderExclusionOrViewThirdPartyAV}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button x:Name="DefenderExclusionButton" MinHeight="28" Padding="10,3" Click="DefenderExclusionButton_Click" />
                        <Button MinHeight="28" Padding="10,3" Content="{l:Localize Key=ThirdPartyAVPaths}" Click="ThirdPartyAvButton_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Grid.Row="3" Padding="10,8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6">
                <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" Text="{l:Localize Key=Language}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock VerticalAlignment="Center" Text="{l:Localize Key=SwitchLanguage}" />
                        <ComboBox x:Name="LanguageComboBox" MinWidth="180" SelectionChanged="LanguageComboBox_SelectionChanged">
                            <ComboBoxItem Content="English (original)" Tag="en-US" />
                            <ComboBoxItem Content="简体中文" Tag="zh-Hans" />
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
