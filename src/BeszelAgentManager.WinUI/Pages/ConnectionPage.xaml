<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="BeszelAgentManager.WinUI.Pages.ConnectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="8" Spacing="8">
            <Border Padding="10,8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6">
                <Grid RowSpacing="4" ColumnSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="165" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="88" />
                        <ColumnDefinition Width="88" />
                    </Grid.ColumnDefinitions>

                    <TextBlock VerticalAlignment="Center" Text="Public Key:" />
                    <TextBox Grid.Column="1" x:Name="KeyTextBox" MinHeight="28" IsReadOnly="True" Text="ssh-ed25519 AAAAA..." />
                    <Button Grid.Column="2" x:Name="KeyChangeButton" MinHeight="28" Padding="10,3" HorizontalAlignment="Stretch" Content="Change" Click="KeyChangeButton_Click" />

                    <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Token:" />
                    <PasswordBox Grid.Row="1" Grid.Column="1" x:Name="TokenBox" MinHeight="28" IsEnabled="False" IsPasswordRevealButtonEnabled="True" />
                    <Button Grid.Row="1" Grid.Column="2" x:Name="TokenChangeButton" MinHeight="28" Padding="10,3" HorizontalAlignment="Stretch" Content="Change" Click="TokenChangeButton_Click" />

                    <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Hub URL:" />
                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="HubUrlTextBox" MinHeight="28" IsReadOnly="True" Text="https://monitoring.local.verhoef.nl" />
                    <Button Grid.Row="2" Grid.Column="2" x:Name="HubUrlChangeButton" MinHeight="28" Padding="10,3" HorizontalAlignment="Stretch" Content="Change" Click="HubUrlChangeButton_Click" />

                    <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="Hub URL IP Fallback:" />
                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="FallbackUrlTextBox" MinHeight="28" IsReadOnly="True" Text="http://192.168.2.247:8090" />
                    <Button Grid.Row="3" Grid.Column="2" x:Name="FallbackChangeButton" MinHeight="28" Padding="10,3" HorizontalAlignment="Stretch" Content="Change" Click="FallbackChangeButton_Click" />
                    <Button Grid.Row="3" Grid.Column="3" x:Name="FallbackToggleButton" MinHeight="28" Padding="10,3" Content="Disable" Click="FallbackToggleButton_Click" />

                    <TextBlock Grid.Row="4" VerticalAlignment="Center" Text="Listen Port:" />
                    <NumberBox Grid.Row="4" Grid.Column="1" x:Name="PortNumberBox" MinHeight="28" IsEnabled="False" Minimum="1" Maximum="65535" SpinButtonPlacementMode="Hidden" Value="45876" />
                    <Button Grid.Row="4" Grid.Column="2" x:Name="PortChangeButton" MinHeight="28" Padding="10,3" HorizontalAlignment="Stretch" Content="Change" Click="PortChangeButton_Click" />
                    <Button Grid.Row="4" Grid.Column="3" x:Name="ListenToggleButton" MinHeight="28" Padding="10,3" Content="Disable" Click="ListenToggleButton_Click" />
                </Grid>
            </Border>

            <Border Padding="10,8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6">
                <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" Text="Automatic updates" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <CheckBox x:Name="AutoUpdateCheckBox" MinHeight="28" Content="Enable automatic updates" IsChecked="True" Click="SettingControl_Changed" />
                        <TextBlock VerticalAlignment="Center" Text="Every" />
                        <TextBox x:Name="UpdateIntervalTextBox"
                                 Width="58"
                                 MinHeight="28"
                                 MaxLength="3"
                                 Text="24"
                                 LostFocus="UpdateIntervalTextBox_LostFocus"
                                 KeyDown="UpdateIntervalTextBox_KeyDown" />
                        <TextBlock VerticalAlignment="Center" Text="hours" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Padding="10,8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6">
                <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" Text="Manager settings" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="AutostartCheckBox" MinHeight="28" Content="Start BeszelAgentManager with Windows" IsChecked="True" Click="SettingControl_Changed" />
                        <Button Grid.Column="1" MinHeight="28" Padding="10,3" Content="Update settings..." Click="ManagerUpdateSettingsButton_Click" />
                    </Grid>
                    <CheckBox x:Name="StartVisibleCheckBox" MinHeight="28" Content="Show window when starting with Windows" Click="SettingControl_Changed" />
                </StackPanel>
            </Border>

            <Border Padding="10,8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="6">
                <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" Text="Service control" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button x:Name="StartServiceButton" MinHeight="28" Padding="10,3" Content="Start service" IsEnabled="False" Click="StartServiceButton_Click" />
                        <Button x:Name="StopServiceButton" MinHeight="28" Padding="10,3" Content="Stop service" IsEnabled="False" Click="StopServiceButton_Click" />
                        <Button x:Name="RestartServiceButton" MinHeight="28" Padding="10,3" Content="Restart service" IsEnabled="False" Click="RestartServiceButton_Click" />
                        <Button x:Name="EditServiceButton" MinHeight="28" Padding="10,3" Content="Edit service..." IsEnabled="False" Click="EditServiceButton_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
